PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/feen
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SIMULATION_CONCURRENCY=1
# Native CPU workers inside one simulation job. Use 0 for all available CPUs.
SIM_WORKER_COUNT=1
INTERNAL_API_KEY=replace-this-with-a-long-random-secret
# Set to false to make every /internal/* route return 503, regardless of key.
INTERNAL_API_ENABLED=true
# Mounts Swagger UI at /docs (spec at /api-docs/openapi.json). Defaults to
# false so it's never accidentally exposed in production -- opt in per
# environment.
SWAGGER_UI_ENABLED=false
TT2_SOCKET_URL=wss://tt2-public.gamehivegames.com
TT2_SOCKET_HANDSHAKE_PATH=/api/socket.io
TT2_REST_BASE_URL=https://tt2-public.gamehivegames.com
TT2_APPLICATION_TOKEN=replace-with-gamehive-application-token
TT2_PLAYER_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Master/Grand Master player token used once for /raid/unsubscribe then /raid/subscribe.
TT2_RAID_SUBSCRIPTION_PLAYER_TOKEN=replace-with-player-token/
