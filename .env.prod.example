# Env file for the full-stack deploy compose (docker-compose.prod.yml), kept
# separate from .env (used by native `cargo run` via dotenvy) and from
# .env.example (its template) so the two never collide.
#
#   cp .env.prod.example .env.prod   # then fill in real values
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- Postgres ---
POSTGRES_DB=feen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
# Optional: overrides the DATABASE_URL the backend connects with, otherwise
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Backend ---
# Origins allowed to call the API, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
SIMULATION_CONCURRENCY=1
SIM_WORKER_COUNT=0
INTERNAL_API_KEY=replace-this-with-a-long-random-secret
INTERNAL_API_ENABLED=true
SWAGGER_UI_ENABLED=false
TT2_APPLICATION_TOKEN=replace-with-gamehive-application-token
TT2_PLAYER_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
TT2_RAID_SUBSCRIPTION_PLAYER_TOKEN=replace-with-player-token
TT2_SOCKET_URL=wss://tt2-public.gamehivegames.com
TT2_SOCKET_HANDSHAKE_PATH=/api/socket.io
TT2_REST_BASE_URL=https://tt2-public.gamehivegames.com
# --- Frontend ---
# Publicly reachable backend URL, baked into the frontend build.
PUBLIC_API_BASE_URL=https://api.example.com
